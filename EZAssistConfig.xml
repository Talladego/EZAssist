<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
  <Scripts>
    <Script file="EZAssist_Config.lua"/>
  </Scripts>
  <Windows>

    <Window name="EZAssistConfig" movable="true" savesettings="false" layer="secondary">
      <Size>
        <AbsPoint x="540" y="620" />
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center" />
      </Anchors>
      <EventHandlers>
        <EventHandler event="OnInitialize" function="EZAssistConfig.Initialize"/>
        <EventHandler event="OnShown" function="EZAssistConfig.OnShown"/>
        <EventHandler event="OnHidden" function="WindowUtils.OnHidden"/>
        <EventHandler event="OnKeyEscape" function="EZAssistConfig.OnCancel"/>
      </EventHandlers>
      <Windows>
        <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" />
        <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
        <DynamicImage name="$parentWindowImage" inherits="EA_Default_SettingsImage" />
        <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="EZAssistConfig.OnCancel" />
          </EventHandlers>
        </Button>

        <Window name="$parentButtonBackground" inherits="EA_Window_DefaultButtonBottomFrame" layer="background">
          <Size>
            <AbsPoint x="0" y="75" />
          </Size>
        </Window>

        <ScrollWindow name="$parentContents" childscrollwindow="EZAssistConfigContentsScrollChild" scrollbar="EZAssistConfigContentsScrollbar" lineheight="18" autoHideScrollBar="true">
          <Anchors>
            <Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTitleBar">
              <AbsPoint x="20" y="10" />
            </Anchor>
            <Anchor point="topright" relativePoint="bottomright" relativeTo="$parentButtonBackground">
              <AbsPoint x="-20" y="-10" />
            </Anchor>
          </Anchors>
          <Windows>
            <VerticalScrollbar name="$parentScrollbar" inherits="EA_ScrollBar_DefaultVerticalChain" layer="popup">
              <Anchors>
                <Anchor point="topright" relativePoint="topright">
                  <AbsPoint x="0" y="0"/>
                </Anchor>
                <Anchor point="bottomright" relativePoint="bottomright">
                  <AbsPoint x="0" y="0"/>
                </Anchor>
              </Anchors>
            </VerticalScrollbar>

            <Window name="$parentScrollChild">
              <Size>
                <AbsPoint x="480" y="500" />
              </Size>
              <Anchors>
                <Anchor point="topleft" relativePoint="topleft">
                  <AbsPoint x="0" y="0" />
                </Anchor>
                <Anchor point="topleft" relativePoint="topright" relativeTo="$parentScrollbar">
                  <AbsPoint x="0" y="0" />
                </Anchor>
              </Anchors>
              <Windows>

                <Window name="$parentSettings">
                  <Size>
                    <AbsPoint x="480" y="500" />
                  </Size>
                  <Anchors>
                    <Anchor point="topleft" relativePoint="topleft">
                      <AbsPoint x="0" y="0"/>
                    </Anchor>
                    <Anchor point="topright" relativePoint="topright">
                      <AbsPoint x="0" y="0"/>
                    </Anchor>
                  </Anchors>
                  <Windows>
                    <FullResizeImage name="$parentBackground" inherits="SettingsSectionBackground" />
                    <Label name="$parentTitle" inherits="EA_Settings_SectionTitle">
                      <Size>
                        <AbsPoint x="400" y="25" />
                      </Size>
                      <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                          <AbsPoint x="10" y="10" />
                        </Anchor>
                      </Anchors>
                    </Label>

                    <Window name="$parentEnabled" inherits="EA_LabelCheckButtonWide">
                      <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                          <AbsPoint x="20" y="42" />
                        </Anchor>
                      </Anchors>
                      <EventHandlers>
                        <EventHandler event="OnInitialize" function="EA_LabelCheckButton.Initialize" />
                        <EventHandler event="OnLButtonUp" function="EZAssistConfig.OnToggleEnabled" />
                      </EventHandlers>
                    </Window>

                    <Label name="$parentInfo" font="font_default_text_small" wordwrap="true" textalign="left" maxchars="1024">
                      <Size>
                        <AbsPoint x="420" y="290" />
                      </Size>
                      <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                          <AbsPoint x="20" y="78" />
                        </Anchor>
                      </Anchors>
                    </Label>

                    <Label name="$parentRangeLabel" font="font_default_text" textalign="left" maxchars="64">
                      <Size>
                        <AbsPoint x="280" y="24" />
                      </Size>
                      <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                          <AbsPoint x="20" y="382" />
                        </Anchor>
                      </Anchors>
                    </Label>
                    <EditBox name="$parentRangeEdit" inherits="EA_EditBox_DefaultFrame" input="numbers" maxchars="4" handleinput="true">
                      <Size>
                        <AbsPoint x="80" y="28" />
                      </Size>
                      <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                          <AbsPoint x="310" y="378" />
                        </Anchor>
                      </Anchors>
                    </EditBox>

                    <Window name="$parentClearHostile" inherits="EA_LabelCheckButtonWide">
                      <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                          <AbsPoint x="20" y="426" />
                        </Anchor>
                      </Anchors>
                      <EventHandlers>
                        <EventHandler event="OnInitialize" function="EA_LabelCheckButton.Initialize" />
                        <EventHandler event="OnLButtonUp" function="EZAssistConfig.OnToggleClearHostile" />
                      </EventHandlers>
                    </Window>

                    <Window name="$parentNotify" inherits="EA_LabelCheckButtonWide">
                      <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                          <AbsPoint x="20" y="462" />
                        </Anchor>
                      </Anchors>
                      <EventHandlers>
                        <EventHandler event="OnInitialize" function="EA_LabelCheckButton.Initialize" />
                        <EventHandler event="OnLButtonUp" function="EZAssistConfig.OnToggleNotify" />
                      </EventHandlers>
                    </Window>
                  </Windows>
                </Window>

              </Windows>
            </Window>
          </Windows>
        </ScrollWindow>

        <Button name="$parentOkayButton" inherits="EA_Button_DefaultResizeable">
          <Size>
            <AbsPoint x="160" y="39" />
          </Size>
          <Anchors>
            <Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="EZAssistConfig">
              <AbsPoint x="15" y="-10" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="EZAssistConfig.OnOkay" />
          </EventHandlers>
        </Button>
        <Button name="$parentApplyButton" inherits="EA_Button_DefaultResizeable">
          <Size>
            <AbsPoint x="160" y="39" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentOkayButton">
              <AbsPoint x="5" y="0" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="EZAssistConfig.OnApply" />
          </EventHandlers>
        </Button>
        <Button name="$parentCancelButton" inherits="EA_Button_DefaultResizeable">
          <Size>
            <AbsPoint x="160" y="39" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentApplyButton">
              <AbsPoint x="5" y="0" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="EZAssistConfig.OnCancel" />
          </EventHandlers>
        </Button>

      </Windows>
    </Window>

  </Windows>
</Interface>
